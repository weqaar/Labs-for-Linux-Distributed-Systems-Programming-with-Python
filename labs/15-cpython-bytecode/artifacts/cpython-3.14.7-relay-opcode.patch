diff --git a/Lib/test/test_relay_opcode.py b/Lib/test/test_relay_opcode.py
new file mode 100644
index 0000000..fb0e14a
--- /dev/null
+++ b/Lib/test/test_relay_opcode.py
@@ -0,0 +1,71 @@
+import builtins
+import dis
+import unittest
+
+
+def direct_task_id(number):
+    return relay_task_id(number)
+
+
+class RelayTaskIdTests(unittest.TestCase):
+    def test_direct_call_uses_custom_opcode(self):
+        operations = [instruction.opname for instruction in dis.get_instructions(direct_task_id)]
+        self.assertIn("RELAY_TASK_ID", operations)
+        self.assertNotIn("CALL", operations)
+        self.assertEqual(direct_task_id(17), "task-17")
+
+    def test_instruction_has_balanced_stack_effect(self):
+        self.assertEqual(dis.stack_effect(dis.opmap["RELAY_TASK_ID"]), 0)
+
+    def test_builtin_supports_indirect_calls(self):
+        factory = builtins.relay_task_id
+        operations = [
+            instruction.opname
+            for instruction in dis.get_instructions(lambda number: factory(number))
+        ]
+        self.assertNotIn("RELAY_TASK_ID", operations)
+        self.assertIn("CALL", operations)
+        self.assertEqual(factory(7), "task-7")
+
+    def test_zero_and_arbitrary_precision_integer(self):
+        self.assertEqual(direct_task_id(0), "task-0")
+        large = 10**100
+        self.assertEqual(direct_task_id(large), f"task-{large}")
+
+    def test_invalid_values_raise_without_corrupting_stack(self):
+        with self.assertRaisesRegex(ValueError, "non-negative integer"):
+            direct_task_id(-1)
+        with self.assertRaisesRegex(TypeError, "non-negative integer"):
+            direct_task_id("17")
+        with self.assertRaisesRegex(TypeError, "non-negative integer"):
+            direct_task_id(True)
+
+    def test_nested_expression_preserves_neighboring_values(self):
+        self.assertEqual(
+            ("before", direct_task_id(4), "after"),
+            ("before", "task-4", "after"),
+        )
+
+    def test_keyword_and_wrong_arity_use_builtin_call_validation(self):
+        with self.assertRaises(TypeError):
+            builtins.relay_task_id(value=1)
+        with self.assertRaises(TypeError):
+            builtins.relay_task_id()
+        with self.assertRaises(TypeError):
+            builtins.relay_task_id(1, 2)
+
+    def test_direct_name_is_a_reserved_compiler_intrinsic(self):
+        namespace = {}
+        exec(
+            "def shadowed(relay_task_id, number):\n"
+            "    return relay_task_id(number)\n",
+            namespace,
+        )
+        shadowed = namespace["shadowed"]
+        self.assertEqual(shadowed(lambda number: f"shadow-{number}", 3), "task-3")
+        operations = [instruction.opname for instruction in dis.get_instructions(shadowed)]
+        self.assertIn("RELAY_TASK_ID", operations)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/Python/bltinmodule.c b/Python/bltinmodule.c
index a8e9a17..24e5964 100644
--- a/Python/bltinmodule.c
+++ b/Python/bltinmodule.c
@@ -3356,6 +3356,42 @@ PyTypeObject PyZip_Type = {
 };
 
 
+/*[clinic input]
+relay_task_id as builtin_relay_task_id
+
+    value: object
+    /
+
+Return ``task-N`` for a non-negative integer N.
+
+Direct calls to this educational builtin compile to the RELAY_TASK_ID
+bytecode instruction.
+[clinic start generated code]*/
+
+static PyObject *
+builtin_relay_task_id(PyObject *module, PyObject *value)
+/*[clinic end generated code: output=47c082948dd69bb3 input=3e022fb650582dbf]*/
+{
+    if (!PyLong_CheckExact(value)) {
+        PyErr_Format(
+            PyExc_TypeError,
+            "relay_task_id() requires a non-negative integer, got %.200s",
+            Py_TYPE(value)->tp_name
+        );
+        return NULL;
+    }
+    if (_PyLong_IsNegative((PyLongObject *)value)) {
+        PyErr_Format(
+            PyExc_ValueError,
+            "relay_task_id() requires a non-negative integer, got %S",
+            value
+        );
+        return NULL;
+    }
+    return PyUnicode_FromFormat("task-%S", value);
+}
