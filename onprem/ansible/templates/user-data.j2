#cloud-config
hostname: {{ item.name }}
fqdn: {{ item.name }}.{{ identity.domain }}
manage_etc_hosts: true
users:
  - name: sigraft
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - {{ lookup('env', 'SIGRAFT_SSH_PUBLIC_KEY') }}
ssh_pwauth: false
disable_root: true
package_update: true
packages: [qemu-guest-agent, chrony, python3]
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, enable, --now, chrony]
